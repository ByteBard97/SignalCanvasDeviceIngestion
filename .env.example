# Environment configuration for device ingestion pipeline

# Claude API
CLAUDE_API_KEY=sk-ant-...

# Ragscallion RAG microservice
RAGSCALLION_HOST=192.168.0.200
RAGSCALLION_PORT=8086
RAGSCALLION_SSH_USER=your-username
RAGSCALLION_SSH_HOST=192.168.0.200
RAGSCALLION_SCRIPT_PATH=~/projects/device-library-rag/scripts/add-paper.sh

# Output paths (relative to repo root)
OUTPUT_DIR=output
STDLIB_OUTPUT=output/stdlib/devices
MANIFESTS_DB=output/ingestion.db
PDF_CACHE_DIR=output/pdf_cache

# Pipeline phases
PHASE_0_DEVICE_COUNT=3
PHASE_1_DEVICE_COUNT=50
PHASE_2_DEVICE_COUNT=1500
PHASE_3_REMAINING=true

# Extraction settings
EXTRACTION_TIMEOUT_SECONDS=120
EXTRACTION_MAX_RETRIES=3

# PDF processing
PDF_DOWNLOAD_TIMEOUT_SECONDS=60
MARKER_TIMEOUT_SECONDS=300
MARKER_MAX_MEMORY_GB=8
